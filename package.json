{
  "name": "zen-view",
  "version": "1.2.0",
  "description": "A lightweight Chrome extension that turns any page, or a picked element on it, into a clean, readable, sanitized view.",
  "main": "service-worker.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
